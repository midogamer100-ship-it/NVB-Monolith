# Keep the build context small and free of secrets.
.git
.gitignore
**/.env
**/.env.*
!.env.example
**/*.pem
**/*.key
**/demo-credentials*.txt
**/node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/venv
**/.mypy_cache
**/.ruff_cache
frontend/dist
backend/app/static
backend/tests
loadtest
deploy
docs
*.md
!frontend/**/*.md
compose.yaml
Containerfile
.dockerignore
.vscode
.idea
