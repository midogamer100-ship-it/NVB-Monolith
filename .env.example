# NVB application configuration (all variables are read by backend/app/config.py).
# Copy to .env (local) or /etc/nvb/nvb.env (VM). Never commit real values.
# SYNTHETIC DEMO ONLY - there are no production defaults for any secret.

# --- Identity shown on the operations page --------------------------------------
# One of: "VMware VM" | "OpenShift VM" | "OpenShift Containers" (free text)
NVB_ENVIRONMENT_LABEL=VMware VM
# NVB_INSTANCE_ID=            # default: <hostname>:<pid>
# NVB_APP_VERSION=1.0.0

# --- Database (either a full URL or the discrete parts) -----------------------------
# NVB_DATABASE_URL=postgresql+psycopg://nvb_app:CHANGE_ME@127.0.0.1:5432/nvb
NVB_DB_HOST=127.0.0.1
NVB_DB_PORT=5432
NVB_DB_NAME=nvb
NVB_DB_USER=nvb_app
NVB_DB_PASSWORD=
NVB_DB_SSLMODE=prefer
NVB_DB_POOL_SIZE=5
NVB_DB_MAX_OVERFLOW=5
NVB_DB_POOL_TIMEOUT_SECONDS=5
NVB_DB_CONNECT_TIMEOUT_SECONDS=3
NVB_DB_STATEMENT_TIMEOUT_MS=10000

# Elevated credentials used ONLY by `python -m app.cli migrate|seed|reset-demo-data`.
NVB_DB_MIGRATION_USER=nvb_owner
NVB_DB_MIGRATION_PASSWORD=

# --- HTTP / security -----------------------------------------------------------------
# Keep true behind HTTPS. Set false ONLY for plain-http localhost development.
NVB_COOKIE_SECURE=true
NVB_SESSION_IDLE_TIMEOUT_MINUTES=15
NVB_SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
# Empty = same-origin only (the frontend is served by the backend; no CORS needed).
NVB_CORS_ORIGINS=
NVB_LOGIN_MAX_FAILURES_PER_USER=5
NVB_LOGIN_MAX_FAILURES_PER_IP=50
NVB_LOGIN_WINDOW_MINUTES=15

# --- Observability -----------------------------------------------------------------
NVB_LOG_LEVEL=INFO
# /metrics requires "Authorization: Bearer <token>". Generate: openssl rand -hex 24
NVB_METRICS_TOKEN=
# Optional read-only Prometheus/Thanos integration for the operations page.
# NVB_PROMETHEUS_URL=https://thanos-querier.openshift-monitoring.svc:9092
# NVB_PROMETHEUS_TOKEN_FILE=/var/run/secrets/nvb-metrics/token
# NVB_PROMETHEUS_CA_FILE=/var/run/secrets/nvb-metrics/service-ca.crt
# NVB_PROMETHEUS_NAMESPACE=nvb-demo
# NVB_PROMETHEUS_DEPLOYMENT=nvb-app

# --- Synthetic CPU workload (scaling demo only; keep false otherwise) ----------------
NVB_DEMO_WORKLOAD_ENABLED=false
NVB_DEMO_WORKLOAD_MAX_CONCURRENCY=2
NVB_DEMO_WORKLOAD_QUEUE_TIMEOUT_SECONDS=10
NVB_DEMO_WORKLOAD_MAX_SECONDS=5
NVB_DEMO_WORKLOAD_SIMULATIONS=3000

# --- Seed / reset (CLI only) ----------------------------------------------------------
# If unset, `seed` generates random passwords and writes them to --credentials-file (0600).
NVB_SEED_CUSTOMER_PASSWORD=
NVB_SEED_LOADTEST_PASSWORD=
NVB_SEED_DEMO_PASSWORD=
NVB_SEED_ADMIN_PASSWORD=
# NVB_SEED_ANCHOR_DATE=2026-11-01   # pin dates for byte-identical reseeds
NVB_ALLOW_DEMO_RESET=false

# --- Process -----------------------------------------------------------------------
# uvicorn worker processes. VM: number of vCPUs. Container: 1 (scale with replicas).
WEB_CONCURRENCY=2
# Required when WEB_CONCURRENCY > 1 so /metrics aggregates all workers (empty dir).
# PROMETHEUS_MULTIPROC_DIR=/run/nvb/prometheus
