# Copy to the repository root as `.env` and replace EVERY value with your own.
# `.env` is git-ignored. These are local demo values only - never reuse them.
POSTGRES_PASSWORD=change-me-owner-password
NVB_APP_DB_PASSWORD=change-me-app-password
NVB_METRICS_TOKEN=change-me-metrics-token

# Optional: choose demo passwords for the seed command. If left empty the seed
# command generates random passwords and writes them to --credentials-file.
NVB_SEED_CUSTOMER_PASSWORD=
NVB_SEED_LOADTEST_PASSWORD=
NVB_SEED_DEMO_PASSWORD=
NVB_SEED_ADMIN_PASSWORD=

# Synthetic CPU workload for the scaling demo (disabled by default).
NVB_DEMO_WORKLOAD_ENABLED=false
# Required (in addition to --confirm) for `python -m app.cli reset-demo-data`.
NVB_ALLOW_DEMO_RESET=false
