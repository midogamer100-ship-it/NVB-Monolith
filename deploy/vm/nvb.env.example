# /etc/nvb/nvb.env  (owner root:nvb, mode 0640)
# Copy this file and set real values on the VM. NEVER commit a filled copy.
# Every variable is documented in backend/app/config.py.
# Format: systemd EnvironmentFile. One KEY=value per line, comments only on
# their own line, quote values that contain spaces. The same file is sourced
# by /opt/nvb/scripts/nvb-admin.sh, so keep it shell-compatible.

# Shown on the operations page. Change to "OpenShift VM" on the migrated VM.
NVB_ENVIRONMENT_LABEL="VMware VM"

# --- Database (PostgreSQL on the same VM, loopback, so no TLS) ---
NVB_DB_HOST=127.0.0.1
NVB_DB_PORT=5432
NVB_DB_NAME=nvb
NVB_DB_USER=nvb_app
NVB_DB_PASSWORD=REPLACE_WITH_NVB_APP_PASSWORD
NVB_DB_SSLMODE=disable
# Per worker process. 2 workers x (5 + 5) = at most 20 connections.
NVB_DB_POOL_SIZE=5
NVB_DB_MAX_OVERFLOW=5

# Elevated credentials for migrate/seed/reset are NOT stored here;
# nvb-admin.sh prompts for the nvb_owner password when it needs it.

# --- HTTP / security (nginx terminates HTTPS) ---
NVB_COOKIE_SECURE=true
# Generate with: openssl rand -hex 32
NVB_METRICS_TOKEN=REPLACE_WITH_RANDOM_HEX
NVB_LOG_LEVEL=INFO

# --- Synthetic CPU workload for the scaling demo (disabled by default) ---
NVB_DEMO_WORKLOAD_ENABLED=false
NVB_DEMO_WORKLOAD_MAX_CONCURRENCY=2
NVB_DEMO_WORKLOAD_SIMULATIONS=3000
NVB_DEMO_WORKLOAD_MAX_SECONDS=5

# Required (plus --confirm) for reset-demo-data. Keep false; nvb-admin.sh
# can set it for a single reset invocation.
NVB_ALLOW_DEMO_RESET=false

# --- Sign-up, password reset (demo mailbox), cash operations -------------------------
NVB_SELF_REGISTRATION_ENABLED=true
NVB_REGISTRATION_MAX_PER_IP_PER_HOUR=10
NVB_PASSWORD_RESET_TTL_MINUTES=15
NVB_ACCOUNT_SETUP_TTL_HOURS=24
# Per-operation limits in piastres: 10,000,000 = 100,000.00 EGP; 5,000,000 = 50,000.00 EGP
NVB_MAX_DEPOSIT_MINOR=10000000
NVB_MAX_WITHDRAWAL_MINOR=5000000
